+"""Regression for https://github.com/pydantic/pydantic/issues/13870."""
+
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+from pydantic import BaseModel, ConfigDict
+
+
+def test_available_attribute_docstrings() -> None:
+    class Config(BaseModel):
+        model_config = ConfigDict(use_attribute_docstrings=True)
+        value: int = 1
+        """An extracted description."""
+
+    assert Config.model_fields["value"].description == "An extracted description."
+
+
+def test_unavailable_module_cloudpickle(tmp_path: Path) -> None:
+    pytest.importorskip("cloudpickle")
+    producer = tmp_path / "producer"
+    worker = tmp_path / "worker"
+    producer.mkdir()
+    worker.mkdir()
+    (producer / "model_defs.py").write_text(
+        "from pydantic import BaseModel, ConfigDict, Field\n"
+        "def make_model():\n"
+        "    class Parent(BaseModel):\n"
+        "        model_config = ConfigDict(use_attribute_docstrings=True)\n"
+        "    class Config(Parent):\n"
+        "        value: int = Field(7, description='Explicit description')\n"
+        "    return Config\n"
+    )
+    scripts = (
+        (producer, "import cloudpickle\nfrom pathlib import Path\n"
+         "from model_defs import make_model\n"
+         "Path('../worker/payload.pkl').write_bytes(cloudpickle.dumps(make_model()()))\n"),
+        (worker, "import cloudpickle\nfrom pathlib import Path\n"
+         "from importlib.util import find_spec\n"
+         "assert find_spec('model_defs') is None\n"
+         "config = cloudpickle.loads(Path('payload.pkl').read_bytes())\n"
+         "assert config.value == 7\n"
+         "assert type(config).model_fields['value'].description == 'Explicit description'\n"),
+    )
+    for directory, script in scripts:
+        result = subprocess.run(
+            [sys.executable, "-c", script], cwd=directory,
+            capture_output=True, text=True, timeout=30, check=False,
+        )
+        assert result.returncode == 0, result.stderr
